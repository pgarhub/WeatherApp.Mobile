<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeatherApp.Mobile.Views.SettingsPage"
             Shell.NavBarIsVisible="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F172A" Offset="0.0" />
            <GradientStop Color="#1E293B" Offset="0.5" />
            <GradientStop Color="#090D16" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid RowDefinitions="Auto, *" Padding="20">

        <!-- GÓRNY PASEK Z POWROTEM -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto, *" Margin="0,10,0,0">
            <Button Grid.Column="0"
                    Text="←"
                    Clicked="OnBackClicked"
                    BackgroundColor="#1E293B"
                    TextColor="White"
                    BorderColor="#334155"
                    BorderWidth="1"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="14"
                    WidthRequest="44"
                    HeightRequest="44"/>

            <Label Grid.Column="1"
                   Text="Ustawienia"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Center"
                   Margin="16,0,0,0"/>
        </Grid>

        <!-- ŚRODEK: KOMUNIKAT -->
        <Border Grid.Row="1"
                StrokeShape="RoundRectangle 24"
                BackgroundColor="#1E293B"
                Stroke="#334155"
                StrokeThickness="1"
                Padding="32"
                HorizontalOptions="Center"
                VerticalOptions="Center">
            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                <Label Text="🚧"
                       FontSize="48"
                       HorizontalOptions="Center"/>
                <Label Text="Trwa rozbudowa"
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"/>
                <Label Text="Opcje konfiguracji pojawią się wkrótce."
                       FontSize="13"
                       TextColor="#94A3B8"
                       HorizontalOptions="Center"
                       HorizontalTextAlignment="Center"/>
            </VerticalStackLayout>
        </Border>

    </Grid>
</ContentPage>