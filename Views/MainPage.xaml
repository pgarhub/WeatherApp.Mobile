<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeatherApp.Mobile.ViewModels"
             x:Class="WeatherApp.Mobile.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#6924FF"
             Shell.NavBarIsVisible="False">

    <Grid>

        <!-- 1. WŁAŚCIWY DASHBOARD (Karta pogody + kafelki) -->
        <Grid RowDefinitions="0.45*, 0.55*" Padding="15" RowSpacing="15">

            <!-- Górna sekcja: WeatherCard -->
            <Border Grid.Row="0" StrokeShape="RoundRectangle 20" BackgroundColor="#2D2D44" Padding="20" StrokeThickness="0">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                    <!-- Miasto z ViewModelu -->
                    <Label Text="{Binding CurrentWeather.CityName}" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>

                    <!-- Ikona pogody z ViewModelu -->
                    <Label Text="{Binding CurrentWeather.Icon}" FontSize="60" HorizontalOptions="Center"/>

                    <!-- Temperatura z ViewModelu -->
                    <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                        <Label Text="{Binding CurrentWeather.Temperature, StringFormat='{0:F1}'}" FontSize="44" FontAttributes="Bold" TextColor="Gold"/>
                        <Label Text="°C" FontSize="44" FontAttributes="Bold" TextColor="Gold"/>
                    </HorizontalStackLayout>

                    <!-- Status pogodowy z ViewModelu -->
                    <Label Text="{Binding CurrentWeather.ConditionText}" FontSize="16" TextColor="LightGray" HorizontalOptions="Center"/>

                    <!-- Przycisk odświeżania -->
                    <Button Text="🔄 Odśwież dane" 
                            Command="{Binding RefreshCommand}"
                            BackgroundColor="#3B3B58" TextColor="White" CornerRadius="10" Margin="0,10,0,0"/>
                </VerticalStackLayout>
            </Border>

            <!-- Dolna sekcja: SensorsGrid (2 kolumny, 2 wiersze) -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="*, *" ColumnSpacing="10" RowSpacing="10">

                <!-- Kafel 1: Kroki -->
                <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10" StrokeThickness="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="👟 Kroki" FontSize="18" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{Binding StepCount, StringFormat='{0} / 10 000'}" FontSize="14" TextColor="Gray" Margin="0,5,0,0" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Kafel 2: Biometria -->
                <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10" StrokeThickness="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="🔒 Biometria" FontSize="18" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="{Binding BiometricStatus}" FontSize="14" TextColor="LightCoral" Margin="0,5,0,0" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Kafel 3: Mapa -->
                <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10" StrokeThickness="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="🗺️ Mapa" FontSize="18" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Brak opadów" FontSize="14" TextColor="Gray" Margin="0,5,0,0" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

                <!-- Kafel 4: Alerty -->
                <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10" StrokeThickness="0">
                    <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                        <Label Text="⚠️ Alerty" FontSize="18" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                        <Label Text="Brak ostrzeżeń" FontSize="14" TextColor="LightGreen" Margin="0,5,0,0" HorizontalOptions="Center"/>
                    </VerticalStackLayout>
                </Border>

            </Grid>

        </Grid>

        <!-- 2. NAKŁADKA EKRANU ŁADOWANIA  -->
        <Grid BackgroundColor="#6a00ff" 
              IsVisible="{Binding IsLoading}"
              VerticalOptions="Fill" HorizontalOptions="Fill">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="15">
                <ActivityIndicator IsRunning="True" 
                                   Color="white" 
                                   WidthRequest="60" HeightRequest="60"/>
                <Label Text="Ładowanie danych pogodowych..." 
                       FontSize="16" 
                       TextColor="White" 
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>
        </Grid>

    </Grid>

</ContentPage>