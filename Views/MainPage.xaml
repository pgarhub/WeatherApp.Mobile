<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeatherApp.Mobile.ViewModels"
             x:Class="WeatherApp.Mobile.Views.MainPage"
             x:DataType="vm:MainViewModel"
             BackgroundColor="#1E1E2E">

    <Grid RowDefinitions="0.45*, 0.55*" Padding="15" RowSpacing="15">

        <!-- Górna sekcja: WeatherCard -->
        <Border Grid.Row="0" StrokeShape="RoundRectangle 20" BackgroundColor="#2D2D44" Padding="20">
            <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" Spacing="8">
                <Label Text="{Binding CurrentWeather.CityName}" FontSize="28" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center"/>
                <Label Text="{Binding CurrentWeather.Icon}" FontSize="60" HorizontalOptions="Center"/>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                    <Label Text="{Binding CurrentWeather.Temperature, StringFormat='{0:F1}'}" FontSize="44" FontAttributes="Bold" TextColor="Gold"/>
                    <Label Text="°C" FontSize="44" FontAttributes="Bold" TextColor="Gold"/>
                </HorizontalStackLayout>

                <Label Text="{Binding CurrentWeather.ConditionText}" FontSize="16" TextColor="LightGray" HorizontalOptions="Center"/>

                <Button Text="🔄 Odśwież dane" Command="{Binding RefreshCommand}" 
                        BackgroundColor="#3B3B58" TextColor="White" CornerRadius="10" Margin="0,10,0,0"/>
            </VerticalStackLayout>
        </Border>

        <!-- Dolna sekcja: SensorsGrid -->
        <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="*, *" ColumnSpacing="10" RowSpacing="10">

            <Border Grid.Row="0" Grid.Column="0" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="👟 Kroki" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="{Binding StepCount, StringFormat='{0} / 10 000'}" FontSize="14" TextColor="Gray" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="0" Grid.Column="1" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="🔒 Biometria" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="{Binding BiometricStatus}" FontSize="14" TextColor="LightCoral" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="0" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="🗺️ Mapa" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="Brak opadów" FontSize="14" TextColor="Gray" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>

            <Border Grid.Row="1" Grid.Column="1" StrokeShape="RoundRectangle 15" BackgroundColor="#252538" Padding="10">
                <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center">
                    <Label Text="⚠️ Alerty" FontSize="18" TextColor="White" FontAttributes="Bold"/>
                    <Label Text="Brak ostrzeżeń" FontSize="14" TextColor="LightGreen" Margin="0,5,0,0"/>
                </VerticalStackLayout>
            </Border>

        </Grid>

    </Grid>

</ContentPage>