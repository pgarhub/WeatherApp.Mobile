<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:WeatherApp.Mobile.ViewModels"
             x:Class="WeatherApp.Mobile.Views.MainPage"
             x:DataType="vm:MainViewModel"
             Shell.NavBarIsVisible="False">

    <!-- TŁO Z GRADIENTEM -->
    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F0C20" Offset="0.0" />
            <GradientStop Color="#1A103C" Offset="0.5" />
            <GradientStop Color="#281545" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <!-- DASHBOARD -->
        <ScrollView>
            <Grid RowDefinitions="Auto, *" Padding="20" RowSpacing="20">

                <!-- 1. GŁÓWNA KARTA POGODOWA -->
                <Border Grid.Row="0" 
                        StrokeShape="RoundRectangle 28" 
                        StrokeThickness="1"
                        Margin="0,10,0,0">
                    <Border.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#ffffff33" Offset="0.0" />
                            <GradientStop Color="#ffffff05" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Stroke>
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#2D1F54" Offset="0.0" />
                            <GradientStop Color="#1F163D" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>

                    <VerticalStackLayout Padding="24" Spacing="12" HorizontalOptions="Center">

                        <!-- Nazwa miasta -->
                        <Label Text="{Binding CurrentWeather.CityName}" 
                               FontSize="30" 
                               FontAttributes="Bold" 
                               TextColor="White" 
                               HorizontalOptions="Center"
                               CharacterSpacing="0.5"/>

                        <!-- Ikona pogody z delikatną poświatą -->
                        <Label Text="{Binding CurrentWeather.Icon}" 
                               FontSize="75" 
                               HorizontalOptions="Center"
                               Margin="0,-5,0,-5"/>

                        <!-- Temperatura -->
                        <HorizontalStackLayout HorizontalOptions="Center" Spacing="2">
                            <Label Text="{Binding CurrentWeather.Temperature, StringFormat='{0:F1}'}" 
                                   FontSize="52" 
                                   FontAttributes="Bold" 
                                   TextColor="#FFD700"/>
                            <Label Text="°C" 
                                   FontSize="28" 
                                   FontAttributes="Bold" 
                                   TextColor="#FFD700"
                                   Margin="2,8,0,0"/>
                        </HorizontalStackLayout>

                        <!-- Opis stanu pogodowego -->
                        <Border StrokeShape="RoundRectangle 12" BackgroundColor="#2Affffff" Padding="12,4" HorizontalOptions="Center" StrokeThickness="0">
                            <Label Text="{Binding CurrentWeather.ConditionText}" 
                                   FontSize="14" 
                                   FontAttributes="Bold"
                                   TextColor="#E0E0E0"/>
                        </Border>

                        <!-- Przycisk Odświeżania -->
                        <Button Text="🔄  Odśwież dane" 
                                Command="{Binding RefreshCommand}"
                                TextColor="White" 
                                FontAttributes="Bold"
                                CornerRadius="16" 
                                HeightRequest="48"
                                Margin="0,15,0,0"
                                Padding="20,0">
                            <Button.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6C5CE7" Offset="0.0" />
                                    <GradientStop Color="#8E44AD" Offset="1.0" />
                                </LinearGradientBrush>
                            </Button.Background>
                        </Button>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. KAFELKI SENSORÓW (GRID 2x2) -->
                <Grid Grid.Row="1" ColumnDefinitions="*, *" RowDefinitions="Auto, Auto" ColumnSpacing="15" RowSpacing="15">

                    <!-- KAFEL 1: KROKI -->
                    <Border Grid.Row="0" Grid.Column="0" 
                            StrokeShape="RoundRectangle 20" 
                            BackgroundColor="#1F1A3A" 
                            Padding="16" 
                            Stroke="#33ffffff" 
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label Text="👟 Kroki" FontSize="16" TextColor="#B8B5D0" FontAttributes="Bold"/>
                            <Label Text="{Binding StepCount, StringFormat='{0}'}" FontSize="22" TextColor="White" FontAttributes="Bold"/>
                            <ProgressBar Progress="0.65" ProgressColor="#6C5CE7" BackgroundColor="#2D284E"/>
                            <Label Text="Cel: 10 000" FontSize="11" TextColor="#8E8AAB"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KAFEL 2: BIOMETRIA -->
                    <Border Grid.Row="0" Grid.Column="1" 
                            StrokeShape="RoundRectangle 20" 
                            BackgroundColor="#1F1A3A" 
                            Padding="16" 
                            Stroke="#33ffffff" 
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🔒 Biometria" FontSize="16" TextColor="#B8B5D0" FontAttributes="Bold"/>
                            <Label Text="{Binding BiometricStatus}" FontSize="15" TextColor="#FF7675" FontAttributes="Bold" Margin="0,4,0,0"/>
                            <Label Text="Status autoryzacji" FontSize="11" TextColor="#8E8AAB"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KAFEL 3: MAPA -->
                    <Border Grid.Row="1" Grid.Column="0" 
                            StrokeShape="RoundRectangle 20" 
                            BackgroundColor="#1F1A3A" 
                            Padding="16" 
                            Stroke="#33ffffff" 
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="🗺️ Radar" FontSize="16" TextColor="#B8B5D0" FontAttributes="Bold"/>
                            <Label Text="Brak opadów" FontSize="15" TextColor="White" FontAttributes="Bold" Margin="0,4,0,0"/>
                            <Label Text="Strefa czysta" FontSize="11" TextColor="#8E8AAB"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- KAFEL 4: ALERTY -->
                    <Border Grid.Row="1" Grid.Column="1" 
                            StrokeShape="RoundRectangle 20" 
                            BackgroundColor="#1F1A3A" 
                            Padding="16" 
                            Stroke="#33ffffff" 
                            StrokeThickness="1">
                        <VerticalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="⚠️ Alerty" FontSize="16" TextColor="#B8B5D0" FontAttributes="Bold"/>
                            <Label Text="Brak ostrzeżeń" FontSize="15" TextColor="#55E6C1" FontAttributes="Bold" Margin="0,4,0,0"/>
                            <Label Text="Pogoda bezpieczna" FontSize="11" TextColor="#8E8AAB"/>
                        </VerticalStackLayout>
                    </Border>

                </Grid>
            </Grid>
        </ScrollView>

        <!-- 3. NAKŁADKA ŁADOWANIA (GLASSHOUSE EFFECT) -->
        <Grid BackgroundColor="#E60F0C20" 
              IsVisible="{Binding IsLoading}"
              VerticalOptions="Fill" 
              HorizontalOptions="Fill">
            <Border StrokeShape="RoundRectangle 24" 
                    BackgroundColor="#251F42" 
                    Padding="30" 
                    HorizontalOptions="Center" 
                    VerticalOptions="Center"
                    Stroke="#44ffffff"
                    StrokeThickness="1">
                <VerticalStackLayout Spacing="15" HorizontalOptions="Center">
                    <ActivityIndicator IsRunning="True" Color="#A29BFE" WidthRequest="50" HeightRequest="50"/>
                    <Label Text="Pobieranie danych..." FontSize="15" TextColor="White" FontAttributes="Bold" HorizontalOptions="Center"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>